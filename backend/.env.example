SQLITE_DATABASE_PATH=./data/luanhung.sqlite

# Required to deliver password-reset OTP emails (SMTP over TLS/STARTTLS).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# SMTP_PASSWORD must be a Google App Password, not your Gmail sign-in password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public payment instructions for manual bank transfers.
# Set BANK_TRANSFER_QR_CODE to a direct QR image URL if you want a custom QR. If left blank, the app generates a QR from the account and amount details.
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_TRANSFER_QR_CODE=

# Public URLs used by payment gateway callbacks.
BACKEND_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# VNPay sandbox/production credentials.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo sandbox/production credentials.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
